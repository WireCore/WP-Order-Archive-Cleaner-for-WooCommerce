{
	"name": "wirecore/wp-order-archive-cleaner-for-woocommerce",
	"description": "Archive old WooCommerce orders in a separate status without deleting them – automatically, with rules, scheduled exports, retention and webhooks.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"woocommerce",
		"orders",
		"archive"
	],
	"homepage": "https://wordpress.org/plugins/circle3-order-archive-cleaner-for-woocommerce/",
	"authors": [
		{
			"name": "WireCore GmbH",
			"homepage": "https://wirecore.net"
		}
	],
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*"
			]
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "*",
		"wp-phpunit/wp-phpunit": "*",
		"roots/wordpress-no-content": "*",
		"composer/installers": "^2.0",
		"wpackagist-plugin/woocommerce": "*",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha"
	},
	"extra": {
		"installer-paths": {
			"vendor/wpackagist-plugin/{$name}/": [
				"type:wordpress-plugin"
			]
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.33"
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"test": "phpunit"
	}
}
