#: includes/class-wirecore-oac-admin.php:308
#, php-format
msgid "Dry run: %1$d orders would be archived, %2$d skipped by rules. No order was changed."
msgstr "Testlauf: %1$d Bestellungen würden archiviert, %2$d durch Regeln übersprungen. Keine Bestellung wurde geändert."

